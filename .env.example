# Copy this file to .env.preview (or .env.preprod) and fill in a wallet seed.
#
# Generate a seed with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Then print your wallet address with:
#   yarn wallet:address
#
# And fund it at the Preview faucet (1,000 tNIGHT):
#   https://midnight-tmnight-preview.nethermind.dev/
#
# Never commit .env.preview or .env.preprod — they are your wallet keys.

# 64-char hex seed, no 0x prefix
MIDNIGHT_PREVIEW_SEED=replace-with-your-64-char-hex-seed

# Optional overrides
# MIDNIGHT_PROOF_SERVER=http://127.0.0.1:6300
# MIDNIGHT_SYNC_TIMEOUT_MS=3600000
# Encrypts the owner key at rest. Must contain at least 3 of: uppercase,
# lowercase, digits, special characters.
# MIDNIGHT_PRIVATE_STATE_PASSWORD=Replace-With-A-Strong-Password-1

# ── Frontend (Vite) ──────────────────────────────────────────────────
# The deployed contract address the web app reads and calls. For local dev
# put this in .env.local; for Vercel/Netlify set it in the project settings.
# VITE_CONTRACT_ADDRESS=
