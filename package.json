{
  "name": "newmoon-counter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private Allowlist Counter - a Midnight dApp that proves key ownership in zero knowledge while keeping a public tally",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "compile": "compact compile contracts/counter.compact managed/counter",
    "test": "NODE_OPTIONS='--experimental-vm-modules' vitest run",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' vitest",
    "proof:up": "docker compose up -d --wait proof-server",
    "proof:down": "docker compose stop proof-server",
    "wallet:address": "vite-node scripts/address.ts",
    "deploy:preview": "vite-node scripts/deploy.ts preview",
    "deploy:preprod": "vite-node scripts/deploy.ts preprod",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "rxjs": "^7.8.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.9",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-node": "^2.1.0",
    "vitest": "^4.1.0"
  }
}
