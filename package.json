{
  "name": "newmoon-counter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private Allowlist Counter - a Midnight dApp that proves key ownership in zero knowledge while keeping a public tally",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "compile": "compact compile contracts/counter.compact managed/counter",
    "verify:compile": "tsx scripts/verify-compile.ts",
    "test": "NODE_OPTIONS='--experimental-vm-modules' vitest run",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' vitest",
    "proof:up": "docker compose up -d --wait proof-server",
    "proof:down": "docker compose stop proof-server",
    "wallet:address": "tsx scripts/address.ts preview",
    "deploy:preview": "tsx scripts/deploy.ts preview",
    "deploy:preprod": "tsx scripts/deploy.ts preprod",
    "increment:preview": "tsx scripts/increment.ts preview",
    "increment:preprod": "tsx scripts/increment.ts preprod",
    "dev": "vite",
    "build": "vite build",
    "preview:web": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@midnight-ntwrk/dapp-connector-api": "^4.0.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.1.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rxjs": "^7.8.2",
    "ws": "^8.14.2"
  },
  "resolutions": {
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0",
    "vitest/vite": "8.3.0"
  },
  "devDependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.5.9",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.0"
  }
}
