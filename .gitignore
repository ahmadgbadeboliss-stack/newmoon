# Dependencies
# Both forms: the trailing slash matches a real directory, the bare name also
# matches a symlink (this repo had node_modules committed as one).
node_modules/
node_modules

# Environment secrets - never commit
.env
.env.*
!.env.example

# Build output
dist/

# Wallet data
deployment.json
.states/

# Encrypted private state store (holds the owner key) - never commit
midnight-level-db/
counter-private-state/
counter-signing-keys/

# Editor
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/
